# Blofin API credentials. Create at https://www.blofin.com → API Management.
# Required permissions: read account, read & write orders.
# IP restriction: set this to your home IP, or leave it off for testing.
BLOFIN_API_KEY=
BLOFIN_API_SECRET=
# Blofin does NOT use a passphrase as part of the HMAC sign string,
# but their docs mention one in some account flows. Leave blank if your
# account doesn't have one. The signing code in blofin_client.py does
# NOT include this value in the request signature.
BLOFIN_PASSPHRASE=

# Nous Portal bearer token. Get this from the Hermes Agent desktop app's
# Nous Portal integration (hermes-agent.nousresearch.com → integrations).
# We use it directly as an OpenAI-compatible API key against
# https://inference-api.nousresearch.com/v1
NOUS_PORTAL_KEY=

# Required if API key was created under Connect to Third-Party Applications
BLOFIN_BROKER_ID=
